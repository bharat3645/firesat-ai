# Copy to .env and fill in to enable LIVE data acquisition. None of these
# are required to run the synthetic pipeline, model, API, or dashboard.

# NASA FIRMS active-fire API key (free): https://firms.modaps.eosdis.gov/api/area/
FIRMS_MAP_KEY=

# Google Earth Engine project id (after `earthengine authenticate`)
EE_PROJECT_ID=

# Reproducibility seed used by the synthetic data generator / training
FIRESAT_SEED=42
